{
  "name": "openprogram-desktop",
  "version": "0.8.1",
  "private": true,
  "description": "Electron desktop shell for OpenProgram",
  "author": "Fzkuji",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://openprogram.io/",
  "repository": "https://github.com/Fzkuji/OpenProgram",
  "main": "main.js",
  "desktopName": "ai.openprogram.OpenProgram.desktop",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron .",
    "check": "npm run check:webtabs && npm run check:no-browser-extensions && npm run check:webtab-zoom-bounds && npm run check:tab-transfer-store && npm run check:window-state && npm run check:window-lifecycle && npm run check:theme-chrome && npm run check:installed-transfer-client && npm run check:worker-auth && npm run check:worker-recovery && npm run check:packaged-runtime && npm run check:updates",
    "check:webtabs": "node scripts/check-webtab-navigation.js",
    "check:no-browser-extensions": "node scripts/check-no-browser-extensions.js",
    "check:webtab-zoom-bounds": "node scripts/check-webtab-zoom-bounds.js",
    "check:tab-transfer-store": "node scripts/check-tab-transfer-store.js",
    "check:window-state": "node scripts/check-window-state.js",
    "check:window-lifecycle": "node scripts/check-window-lifecycle.js",
    "check:theme-chrome": "node scripts/check-theme-chrome.js",
    "check:installed-transfer-client": "node scripts/check-installed-tab-transfer-client.js",
    "check:worker-auth": "node scripts/check-worker-start-url.js && node scripts/check-self-update-reopen.js && node scripts/check-self-update-ui-guard.js && node scripts/check-self-update-ui.js",
    "check:worker-recovery": "node scripts/check-worker-recovery.js",
    "check:packaged-runtime": "node scripts/check-packaged-runtime.js",
    "check:updates": "node scripts/check-update-service.js",
    "icon:check": "bash scripts/check-icon.sh",
    "prepare:runtime": "bash ../../scripts/release/prepare-desktop-runtime.sh",
    "dist": "npm run app:install",
    "app:install": "bash scripts/package-and-install-app.sh",
    "dist:mac": "npm run prepare:runtime && npm run icon:check && electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.openprogram.desktop",
    "productName": "OpenProgram",
    "afterPack": "scripts/write-reopen-protocol.cjs",
    "files": [
      "main.js",
      "menu-geometry.js",
      "worker-recovery-state.js",
      "tab-transfer-validation.js",
      "preload.js",
      "update-service.js",
      "packaged-runtime.js",
      "worker-start-url.js",
      "self-update-reopen.js",
      "self-update-ui.js",
      "self-update-ui-guard.js",
      "self-update-ui-scroll.js",
      "self-update-ui-test-object.js",
      "tab-transfer-store.js",
      "window-state.js",
      "window-lifecycle.js",
      "theme-chrome.js",
      "browsing-history-store.js",
      "browser-profile-import.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/install-app.sh",
        "to": "update/install-app.sh"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false
    }
  },
  "dependencies": {
    "node-pty": "1.0.0"
  }
}
