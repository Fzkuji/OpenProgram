  "cards": [
    {"dot": "cyan", "title": "Web 面板", "items": ["状态条打开完整 Goal，不是静态标签", "问题可累计并按 question ID 异步回答"]},
    {"dot": "violet", "title": "TUI 命令", "items": ["/goal answer 与 Web 使用同一动作合同", "回答不打断仍在进行的独立工作"]},
