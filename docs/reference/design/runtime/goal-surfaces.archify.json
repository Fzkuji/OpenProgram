    {"id": "panel", "lane": "web", "col": 1, "type": "frontend", "label": "Goal 详情面板", "sublabel": "prompt · checklist · 问题队列", "width": 154},
    {"id": "tui_status", "lane": "tui", "col": 0, "type": "frontend", "label": "/goal status", "sublabel": "完整状态与原因", "width": 150},
    {"id": "tui_action", "lane": "tui", "col": 1, "type": "frontend", "label": "/goal action", "sublabel": "edit · answer · resume · clear", "width": 154},
    {"id": "action", "lane": "contract", "col": 2, "type": "backend", "label": "Goal Action API", "sublabel": "同一校验与错误合同", "width": 154},
    {"id": "transition", "lane": "contract", "col": 3, "type": "security", "label": "版本化转移", "sublabel": "expected_version · lease", "width": 154},
    {"id": "repository", "lane": "state", "col": 4, "type": "database", "label": "Goal Snapshot", "sublabel": "checkpoint + question queue", "width": 154},
    {"id": "projection", "lane": "state", "col": 5, "type": "messagebus", "label": "Goal Projection", "sublabel": "hydrate + goal_update", "width": 154}
